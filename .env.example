# Secrets: put them in .env like any other variable, and everything works with no keyring involved.
# Optional: "uv run acidbase keyring plan", then "copy" and "strip", moves them into the OS keyring and leaves a
# "# keyring: NAME" line in .env. A startup hook from acidbase then fills the environment of each Python process in
# this repo, and a variable already set in the environment wins. "restore" undoes the move.

# Optional: override the default acidbase security-patch config location.
# Defaults to <repo-root>/config/security_patch.toml when unset.
ACIDBASE_SECURITY_CONFIG=

# GitHub CLI token. The acidbase CLI shells out to `gh`; authenticate with
# `gh auth login` rather than setting this directly unless you need a fixed token.
GITHUB_TOKEN={{github_token}}

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

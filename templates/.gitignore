# Canonical .gitignore for the a6a ecosystem.
# Single source of truth maintained in acidbase/templates/.gitignore.

# Agenticity
.serena/

# Backup files
*.backup
*.bak
app_backup/

# Byte-compiled/optimized/DLL files
*$py.class
*.egg-info/
*.py[cod]
*.pyo
/Backup.egg-info/
__pycache__/

# C extensions
*.so

# celery beat schedule file
celerybeat-schedule

# Distribution/packaging
*.egg
.eggs/
.installed.cfg
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
pip-wheel-metadata/
sdist/
share/python-wheels/
var/
wheels/

# Django stuff
*.log
db.sqlite3
db.sqlite3-journal
local_settings.py

# Environments
# .python-version is deliberately tracked: CI's `uv python install` reads it.
.env
.env.*
!.env.example
.venv/
ENV/
env.bak/
env/
venv.bak/
venv/

# Flask stuff
.webassets-cache
instance/

# IDE
*.swo
*.swp
*~
.idea/
.junie/
.vscode/
AGENTS.md
WARP.md

